{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CONTROL_PLANE_BASE_URL": "https://cp.roofspan.io",
        "EXPO_PUBLIC_RELAY_WSS_URL": "wss://relay.roofspan.io"
      },
      "ios": { "simulator": false },
      "android": { "buildType": "apk" }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CONTROL_PLANE_BASE_URL": "https://cp.roofspan.io",
        "EXPO_PUBLIC_RELAY_WSS_URL": "wss://relay.roofspan.io"
      },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CONTROL_PLANE_BASE_URL": "https://cp.roofspan.io",
        "EXPO_PUBLIC_RELAY_WSS_URL": "wss://relay.roofspan.io"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CONTROL_PLANE_BASE_URL": "https://cp.roofspan.io",
        "EXPO_PUBLIC_RELAY_WSS_URL": "wss://relay.roofspan.io"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
