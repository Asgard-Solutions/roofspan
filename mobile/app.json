{
  "expo": {
    "name": "RoofSpan Field",
    "slug": "roofspan",
    "owner": "asgard-solution-llc",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "roofspan",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "io.roofspan.field" },
    "android": {
      "package": "io.roofspan.field",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-secure-store",
      "expo-image-picker",
      "expo-dev-client",
      "@maplibre/maplibre-react-native",
      ["expo-camera", { "cameraPermission": "RoofSpan uses the camera to scan the pairing QR code shown in RoofSpan Office." }]
    ],
    "extra": {
      "controlPlaneBase": "https://cp.roofspan.io",
      "apiBase": "https://cp.roofspan.io",
      "relayWss": "wss://relay.roofspan.io",
      "eas": {
        "projectId": "edcd6d6d-f0e9-49a0-8fd1-0ba39ff11bef"
      }
    }
  }
}
