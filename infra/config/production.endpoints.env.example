# RoofSpan production client endpoints - explicit public values.
# The Relay URL is never derived from the Control Plane URL, and no Emergent preview URL is allowed.

# RoofSpan Office (written into local backend config at install).
CONTROL_PLANE_BASE_URL=https://cp.roofspan.io
RELAY_WSS_URL=wss://relay.roofspan.io
ROOFSPAN_RELAY_WS_URL=wss://relay.roofspan.io/api/relay/installation

# RoofSpan Mobile (Expo public build-time values).
EXPO_PUBLIC_CONTROL_PLANE_BASE_URL=https://cp.roofspan.io
EXPO_PUBLIC_RELAY_WSS_URL=wss://relay.roofspan.io
