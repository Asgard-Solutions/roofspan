# RoofSpan production client endpoints — EXPLICIT values (Relay URL is NOT derived from CP URL).
# No Emergent preview URLs. Clients must FAIL CLEARLY if these are absent in production builds.

# RoofSpan Office (written into the local backend config at install; see windows/winbuild/config).
CONTROL_PLANE_BASE_URL=https://cp.roofspan.io
RELAY_WSS_URL=wss://relay.roofspan.io

# RoofSpan Mobile (Expo public env — build-time, e.g. app.config / eas env). Public URLs only.
EXPO_PUBLIC_CONTROL_PLANE_BASE_URL=https://cp.roofspan.io
EXPO_PUBLIC_RELAY_WSS_URL=wss://relay.roofspan.io
