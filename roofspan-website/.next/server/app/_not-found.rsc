8:Tae8,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can RoofSpan help us find properties to canvass?","acceptedAnswer":{"@type":"Answer","text":"Yes. RoofSpan brings property records onto the map with owner information, property type, year built and square footage where available, so you can see and organize the properties worth working."}},{"@type":"Question","name":"Can I assign neighborhoods to individual salespeople?","acceptedAnswer":{"@type":"Answer","text":"Yes. In RoofSpan Office you draw territories and smaller canvass sections, see which properties fall inside each, resolve assignment overlaps, and assign sections to specific salespeople."}},{"@type":"Question","name":"What does a salesperson see in RoofSpan Mobile?","acceptedAnswer":{"@type":"Answer","text":"Each salesperson opens My Area to see their assigned canvass section — a property map, owner and occupancy context, Do-Not-Knock properties, visit outcomes, photos and inspections, and the leads and jobs tied to their work."}},{"@type":"Question","name":"Does RoofSpan integrate with ABC Supply?","acceptedAnswer":{"@type":"Answer","text":"Yes. Connect your ABC Supply account to browse the catalog, add products to RoofSpan inventory, retrieve account-specific pricing, build purchase orders, place orders, and review order history and templates."}},{"@type":"Question","name":"Can RoofSpan show property ownership information?","acceptedAnswer":{"@type":"Answer","text":"RoofSpan can surface owner information and whether a property is owner-occupied or non-owner-occupied. Available property and ownership information varies by source and location."}},{"@type":"Question","name":"What do I need to run RoofSpan Office?","acceptedAnswer":{"@type":"Answer","text":"RoofSpan Office installs and runs on your company's own Windows computer and opens through a local browser interface. There is no separate hosted web application to log into."}},{"@type":"Question","name":"How does RoofSpan Mobile connect?","acceptedAnswer":{"@type":"Answer","text":"Field users install the free RoofSpan Mobile app and pair it with your company's RoofSpan Office installation. Mobile is built for the field, with locally cached data and queued updates that synchronize back to Office when connectivity is available."}},{"@type":"Question","name":"How much does RoofSpan cost?","acceptedAnswer":{"@type":"Answer","text":"RoofSpan is $49 per user per month with a five-user minimum, so pricing starts at $245 per month. RoofSpan Mobile is included at no extra cost."}},{"@type":"Question","name":"Where does my data live?","acceptedAnswer":{"@type":"Answer","text":"Your operational roofing database lives with your RoofSpan Office installation on your company's own Windows system."}}]}0:["vi2fR7U8y923KnGsoToxi",[[["",{"children":["/_not-found",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["/_not-found",{"children":["__PAGE__",{},[["$L1",[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":"404"}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px"