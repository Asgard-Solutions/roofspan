8:T4e8,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What do I need to run RoofSpan Office?","acceptedAnswer":{"@type":"Answer","text":"RoofSpan Office installs and runs on your company's own Windows computer and opens through a local browser interface. There is no separate hosted web application to log into."}},{"@type":"Question","name":"How does RoofSpan Mobile connect?","acceptedAnswer":{"@type":"Answer","text":"Field users install the free RoofSpan Mobile app and pair it with your company's RoofSpan Office installation to securely connect while away from the office."}},{"@type":"Question","name":"How much does RoofSpan cost?","acceptedAnswer":{"@type":"Answer","text":"RoofSpan is $49 per user per month with a five-user minimum, so pricing starts at $245 per month."}},{"@type":"Question","name":"Where does my data live?","acceptedAnswer":{"@type":"Answer","text":"Your operational roofing database lives with your RoofSpan Office installation on your company's own Windows system."}},{"@type":"Question","name":"Is RoofSpan available now?","acceptedAnswer":{"@type":"Answer","text":"RoofSpan is in early access. Join the early-access list and we'll be in touch about getting your company set up."}}]}0:["1u1KwA1wbXCB0SY2PnZxo",[[["",{"children":["/_not-found",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["/_not-found",{"children":["__PAGE__",{},[["$L1",[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-colo