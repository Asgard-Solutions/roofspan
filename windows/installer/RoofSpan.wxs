<?xml version="1.0" encoding="UTF-8"?>
<!--
  RoofSpan Office — WiX v4 MSI definition.
  Target: Windows 10/11 x64. Produces RoofSpanOffice-{VERSION}.msi (wrapped by bundle.wxs -> RoofSpanSetup.exe).

  Per-machine install with three restricted Windows services, a preserved local data directory under
  ProgramData, clean data-preserving major-upgrade, and data-preserving uninstall. Contains NO secrets
  (no AWS/Stripe/RevenueCat/entitlement/update private keys, no per-customer license). Activation happens
  at first run via the existing licensing flow. The application payload is harvested at build time from
  the staged tree ($(var.StageDir), assembled by installer\stage.ps1). Building/signing is HUMAN REQUIRED
  on Windows (WiX v4 tooling + Authenticode cert).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?include constants.wxi ?>

  <Package Name="$(var.ProductName)" Manufacturer="$(var.Manufacturer)"
           Version="$(var.Version)" UpgradeCode="$(var.RoofSpanUpgradeCode)"
           Scope="perMachine" Compressed="yes">

    <!-- Upgrade in place; never install a second conflicting instance; preserve data across upgrades. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of RoofSpan Office is already installed."
                  Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Directory layout: binaries under Program Files; MUTABLE customer data under ProgramData. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RoofSpan Office">
        <Directory Id="ServicesDir" Name="services" />
        <Directory Id="ToolsDir" Name="tools" />
        <Directory Id="FrontendDir" Name="frontend" />
        <Directory Id="RuntimeDir" Name="runtime" />
        <Directory Id="ConfigTemplatesDir" Name="config-templates" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataRoot" Name="RoofSpan">
        <Directory Id="DbDataDir" Name="pgdata" />       <!-- local PostgreSQL data (PRESERVED) -->
        <Directory Id="IdentityDir" Name="identity" />   <!-- installation identity keys (PRESERVED) -->
        <Directory Id="LogsDir" Name="logs" />
        <Directory Id="ConfigDir" Name="config" />
        <Directory Id="SecretsDir" Name="secrets" />
      </Directory>
    </StandardDirectory>

    <!-- Application payload harvested at build time from the staged trees (WiX v4 Files element). -->
    <ComponentGroup Id="FrontendFiles" Directory="FrontendDir">
      <Files Include="$(var.StageDir)\frontend\**" />
    </ComponentGroup>
    <ComponentGroup Id="RuntimeFiles" Directory="RuntimeDir">
      <Files Include="$(var.StageDir)\runtime\**" />
    </ComponentGroup>
    <ComponentGroup Id="ConfigTemplateFiles" Directory="ConfigTemplatesDir">
      <Files Include="$(var.StageDir)\config-templates\**" />
    </ComponentGroup>

    <!-- Windows services (minimal set, auto-start, restart-on-failure, restricted identity).
         KeyPath exes are the PyInstaller outputs produced by packaging\build_exes.ps1 into services\. -->
    <ComponentGroup Id="Services" Directory="ServicesDir">
      <Component Id="Svc_Backend" Guid="*">
        <File Id="BackendExe" Source="$(var.StageDir)\services\roofspan-backend.exe" KeyPath="yes" />
        <ServiceInstall Id="RoofSpanBackend" Name="RoofSpanBackend" DisplayName="RoofSpan Backend"
                        Description="RoofSpan local API + local browser UI (binds 127.0.0.1 only)."
                        Type="ownProcess" Start="auto" ErrorControl="normal"
                        Account="NT SERVICE\RoofSpanBackend" Vital="yes">
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                              ThirdFailureActionType="restart" RestartServiceDelayInSeconds="10" />
        </ServiceInstall>
        <ServiceControl Id="CtlBackend" Name="RoofSpanBackend" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <Component Id="Svc_Relay" Guid="*">
        <File Id="RelayExe" Source="$(var.StageDir)\services\roofspan-relay-connector.exe" KeyPath="yes" />
        <ServiceInstall Id="RoofSpanRelay" Name="RoofSpanRelayConnector" DisplayName="RoofSpan Relay Connector"
                        Description="Outbound-only Secure Relay tunnel (no inbound ports)." Type="ownProcess"
                        Start="auto" ErrorControl="normal" Account="NT SERVICE\RoofSpanRelay">
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                              ThirdFailureActionType="restart" RestartServiceDelayInSeconds="15" />
        </ServiceInstall>
        <ServiceControl Id="CtlRelay" Name="RoofSpanRelayConnector" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <Component Id="Svc_Updater" Guid="*">
        <File Id="UpdaterExe" Source="$(var.StageDir)\services\roofspan-update-service.exe" KeyPath="yes" />
        <ServiceInstall Id="RoofSpanUpdate" Name="RoofSpanUpdateService" DisplayName="RoofSpan Update Service"
                        Description="Checks downloads.roofspan.io for signed updates every 12h; verifies + applies safely."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="NT SERVICE\RoofSpanUpdate" />
        <ServiceControl Id="CtlUpdater" Name="RoofSpanUpdateService" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
    </ComponentGroup>

    <!-- Operator recovery tool (NOT a service, NOT auto-started). Admin-only local Owner password reset.
         Exposed via a Start Menu shortcut under a RoofSpan Maintenance folder, not in the Office UI. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuRoofSpan" Name="RoofSpan Office">
        <Directory Id="StartMenuMaint" Name="Maintenance" />
      </Directory>
    </StandardDirectory>
    <ComponentGroup Id="Tools" Directory="ToolsDir">
      <Component Id="Tool_OwnerRecovery" Guid="*">
        <File Id="OwnerRecoveryExe" Source="$(var.StageDir)\tools\RoofSpanOwnerRecovery.exe" KeyPath="yes" />
        <Shortcut Id="ScOwnerRecovery" Directory="StartMenuMaint"
                  Name="RoofSpan Owner Recovery (Administrator)"
                  Description="Reset the RoofSpan Owner password. Requires 'Run as administrator'."
                  Advertise="yes" />
      </Component>
      <Component Id="Tool_Bootstrap" Guid="*">
        <File Id="BootstrapExe" Source="$(var.StageDir)\tools\RoofSpanBootstrap.exe" KeyPath="yes" />
      </Component>
      <Component Id="StartMenuCleanup" Directory="StartMenuMaint" Guid="*">
        <RemoveFolder Id="RmStartMenuMaint" Directory="StartMenuMaint" On="uninstall" />
        <RemoveFolder Id="RmStartMenuRoofSpan" Directory="StartMenuRoofSpan" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\RoofSpan\Office" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Persisted data marker: created if absent, NEVER removed on uninstall/upgrade. -->
    <Component Id="DataDirs" Directory="DataRoot" Guid="*" Permanent="yes" NeverOverwrite="yes">
      <CreateFolder />
      <RegistryValue Root="HKLM" Key="Software\RoofSpan\Office" Name="DataRoot"
                     Type="string" Value="[DataRoot]" KeyPath="yes" />
    </Component>

    <!-- Least-privilege ACLs so the per-service virtual accounts (NT SERVICE\*) can read config,
         read/create the installation identity, and write logs WITHOUT elevated rights. The folders are
         created here and preserved across upgrade/uninstall.
         HUMAN REQUIRED: validate on a real box that NT SERVICE\<name> resolves at ACL time (it is created
         by ServiceInstall); if ordering is a problem, move these grants to a post-StartServices custom
         action. -->
    <ComponentGroup Id="DataAcls">
      <Component Id="AclConfig" Directory="ConfigDir" Guid="*" Permanent="yes" NeverOverwrite="yes">
        <CreateFolder>
          <util:PermissionEx User="RoofSpanRelay" Domain="NT SERVICE" GenericRead="yes" GenericExecute="yes" />
          <util:PermissionEx User="RoofSpanBackend" Domain="NT SERVICE" GenericRead="yes" GenericExecute="yes" />
          <util:PermissionEx User="RoofSpanUpdate" Domain="NT SERVICE" GenericRead="yes" GenericExecute="yes" />
        </CreateFolder>
      </Component>
      <Component Id="AclIdentity" Directory="IdentityDir" Guid="*" Permanent="yes" NeverOverwrite="yes">
        <CreateFolder>
          <util:PermissionEx User="RoofSpanRelay" Domain="NT SERVICE" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
          <util:PermissionEx User="RoofSpanBackend" Domain="NT SERVICE" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
        </CreateFolder>
      </Component>
      <Component Id="AclLogs" Directory="LogsDir" Guid="*" Permanent="yes" NeverOverwrite="yes">
        <CreateFolder>
          <util:PermissionEx User="RoofSpanRelay" Domain="NT SERVICE" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
          <util:PermissionEx User="RoofSpanBackend" Domain="NT SERVICE" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
          <util:PermissionEx User="RoofSpanUpdate" Domain="NT SERVICE" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
        </CreateFolder>
      </Component>
      <!-- Installation secrets (JWT + encryption key) live here, writable ONLY by the Backend account.
           Relay/Updater get NO access. Persisted across upgrade/uninstall with customer data. -->
      <Component Id="AclSecrets" Directory="SecretsDir" Guid="*" Permanent="yes" NeverOverwrite="yes">
        <CreateFolder>
          <util:PermissionEx User="RoofSpanBackend" Domain="NT SERVICE" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="RoofSpan Office" Level="1">
      <ComponentGroupRef Id="FrontendFiles" />
      <ComponentGroupRef Id="RuntimeFiles" />
      <ComponentGroupRef Id="ConfigTemplateFiles" />
      <ComponentGroupRef Id="Services" />
      <ComponentGroupRef Id="Tools" />
      <ComponentRef Id="DataDirs" />
      <ComponentGroupRef Id="DataAcls" />
    </Feature>

    <!-- First-run: open the local setup/login UI so the customer runs the existing activation flow. -->
    <!-- First-install DB + deployed-config bootstrap. Runs BEFORE StartServices so RoofSpanBackend never
         starts without its generated local DATABASE_URL. Upgrade/repair preserves existing creds. Native
         psql/role/db execution is HUMAN REQUIRED. PgSuperPassword is passed by the bundle (bundle.wxs). -->
    <SetProperty Id="RoofSpanBootstrap"
                 Value="&quot;[ToolsDir]RoofSpanBootstrap.exe&quot;"
                 Before="RoofSpanBootstrap" Sequence="execute" />
    <CustomAction Id="RoofSpanBootstrap" BinaryRef="Wix4UtilCA_X86" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="SetBootstrapEnv" Property="RoofSpanBootstrap"
                  Value="&quot;[ToolsDir]RoofSpanBootstrap.exe&quot;" />

    <CustomAction Id="LaunchFirstRun" Directory="INSTALLFOLDER"
                  ExeCommand="[SystemFolder]cmd.exe /c start &quot;&quot; &quot;http://127.0.0.1:8001/&quot;"
                  Execute="deferred" Impersonate="yes" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="RoofSpanBootstrap" Before="StartServices" Condition="NOT Installed" />
      <Custom Action="LaunchFirstRun" After="StartServices" Condition="NOT Installed" />
    </InstallExecuteSequence>

    <!-- Uninstall: business data (pgdata, identity) is retained by default. A destructive
         "remove all RoofSpan data" is a separate, explicitly-confirmed option (not default). -->
  </Package>
</Wix>
