<?xml version="1.0" encoding="UTF-8"?>
<!--
  RoofSpan Office - WiX 5 (Toolset 5.0.2) MSI definition.
  Target: Windows 10/11 x64. Produces RoofSpanOffice-{VERSION}.msi (wrapped by bundle.wxs -> RoofSpanSetup.exe).

  Per-machine install with three restricted Windows services, Windows shell integration, a preserved local
  data directory under ProgramData, clean data-preserving major-upgrade, and data-preserving uninstall.
  Contains NO secrets (no AWS/Stripe/RevenueCat/entitlement/update private keys, no per-customer license).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?include constants.wxi ?>

  <Package Name="$(var.ProductName)" Manufacturer="$(var.Manufacturer)"
           Version="$(var.Version)" UpgradeCode="$(var.RoofSpanUpgradeCode)"
           Scope="perMachine" Compressed="yes">

    <!-- Upgrade in place; never install a second conflicting instance; preserve data across upgrades. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of RoofSpan Office is already installed."
                  Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Canonical RoofSpan icon used by Windows Apps/Installed Apps plus desktop/Start-menu shortcuts. -->
    <Icon Id="RoofSpanIcon" SourceFile="$(var.StageDir)\runtime\RoofSpan.ico" />
    <Property Id="ARPPRODUCTICON" Value="RoofSpanIcon" />

    <!-- Directory layout: binaries under Program Files; MUTABLE customer data under ProgramData. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RoofSpan Office">
        <Directory Id="ServicesDir" Name="services">
          <Directory Id="BackendSvcDir" Name="roofspan-backend">
            <Directory Id="BackendInternalDir" Name="_internal" />
          </Directory>
          <Directory Id="RelaySvcDir" Name="roofspan-relay-connector">
            <Directory Id="RelayInternalDir" Name="_internal" />
          </Directory>
          <Directory Id="UpdateSvcDir" Name="roofspan-update-service">
            <Directory Id="UpdateInternalDir" Name="_internal" />
          </Directory>
        </Directory>
        <Directory Id="FrontendDir" Name="frontend" />
        <Directory Id="RuntimeDir" Name="runtime" />
        <Directory Id="ConfigTemplatesDir" Name="config-templates" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataRoot" Name="RoofSpan">
        <Directory Id="DbDataDir" Name="pgdata" />
        <Directory Id="IdentityDir" Name="identity" />
        <Directory Id="LogsDir" Name="logs" />
        <Directory Id="ConfigDir" Name="config" />
      </Directory>
    </StandardDirectory>

    <!-- Application payload harvested at build time from the staged trees. -->
    <ComponentGroup Id="FrontendFiles" Directory="FrontendDir">
      <Files Include="$(var.StageDir)\frontend\**" />
    </ComponentGroup>
    <ComponentGroup Id="RuntimeFiles" Directory="RuntimeDir">
      <Files Include="$(var.StageDir)\runtime\**" />
    </ComponentGroup>
    <ComponentGroup Id="ConfigTemplateFiles" Directory="ConfigTemplatesDir">
      <Files Include="$(var.StageDir)\config-templates\**" />
    </ComponentGroup>

    <!-- Windows services: REAL native SCM services (pywin32-hosted). -->
    <ComponentGroup Id="Services">
      <Component Id="Svc_Backend" Directory="BackendSvcDir" Guid="*">
        <File Id="BackendExe" Source="$(var.StageDir)\services\roofspan-backend\roofspan-backend.exe" KeyPath="yes" />
        <ServiceInstall Id="RoofSpanBackend" Name="RoofSpanBackend" DisplayName="RoofSpan Backend"
                        Description="RoofSpan local API + local browser UI (binds 127.0.0.1 only)."
                        Type="ownProcess" Start="auto" ErrorControl="normal"
                        Account="NT SERVICE\RoofSpanBackend" Vital="yes">
          <ServiceDependency Id="RoofSpanPostgreSQL" />
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                              ThirdFailureActionType="restart" RestartServiceDelayInSeconds="10" />
        </ServiceInstall>
        <ServiceControl Id="CtlBackend" Name="RoofSpanBackend" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>

      <Component Id="Svc_Relay" Directory="RelaySvcDir" Guid="*">
        <File Id="RelayExe" Source="$(var.StageDir)\services\roofspan-relay-connector\roofspan-relay-connector.exe" KeyPath="yes" />
        <ServiceInstall Id="RoofSpanRelay" Name="RoofSpanRelayConnector" DisplayName="RoofSpan Relay Connector"
                        Description="Outbound-only Secure Relay tunnel (no inbound ports)." Type="ownProcess"
                        Start="auto" ErrorControl="normal" Account="NT SERVICE\RoofSpanRelayConnector">
          <ServiceDependency Id="RoofSpanBackend" />
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                              ThirdFailureActionType="restart" RestartServiceDelayInSeconds="15" />
        </ServiceInstall>
        <ServiceControl Id="CtlRelay" Name="RoofSpanRelayConnector" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>

      <Component Id="Svc_Updater" Directory="UpdateSvcDir" Guid="*">
        <File Id="UpdaterExe" Source="$(var.StageDir)\services\roofspan-update-service\roofspan-update-service.exe" KeyPath="yes" />
        <ServiceInstall Id="RoofSpanUpdate" Name="RoofSpanUpdateService" DisplayName="RoofSpan Update Service"
                        Description="Checks downloads.roofspan.io for signed updates every 12h; verifies + applies safely."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="NT SERVICE\RoofSpanUpdateService">
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                              ThirdFailureActionType="restart" RestartServiceDelayInSeconds="30" />
        </ServiceInstall>
        <ServiceControl Id="CtlUpdater" Name="RoofSpanUpdateService" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
    </ComponentGroup>

    <!-- PyInstaller onedir dependency payload. -->
    <ComponentGroup Id="ServiceInternals">
      <Files Include="$(var.StageDir)\services\roofspan-backend\_internal\**" Directory="BackendInternalDir" />
      <Files Include="$(var.StageDir)\services\roofspan-relay-connector\_internal\**" Directory="RelayInternalDir" />
      <Files Include="$(var.StageDir)\services\roofspan-update-service\_internal\**" Directory="UpdateInternalDir" />
    </ComponentGroup>

    <!-- Windows shell integration. The actual application is the local Office UI served at 127.0.0.1;
         Explorer opens that URL with the user's default browser. These shortcuts are MSI-owned so upgrades
         repair them and uninstall removes them automatically. -->
    <Component Id="ShellShortcuts" Directory="INSTALLFOLDER" Guid="*">
      <Shortcut Id="RoofSpanDesktopShortcut"
                Directory="DesktopFolder"
                Name="RoofSpan Office"
                Description="Open RoofSpan Office"
                Target="[WindowsFolder]explorer.exe"
                Arguments="http://127.0.0.1:8001/"
                WorkingDirectory="INSTALLFOLDER"
                Icon="RoofSpanIcon"
                IconIndex="0" />
      <Shortcut Id="RoofSpanStartMenuShortcut"
                Directory="ProgramMenuFolder"
                Name="RoofSpan Office"
                Description="Open RoofSpan Office"
                Target="[WindowsFolder]explorer.exe"
                Arguments="http://127.0.0.1:8001/"
                WorkingDirectory="INSTALLFOLDER"
                Icon="RoofSpanIcon"
                IconIndex="0" />
      <RegistryValue Root="HKLM" Key="Software\RoofSpan\Office" Name="ShellShortcuts"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Persisted data dirs + ACLs. -->
    <Component Id="DataDirs" Directory="DataRoot" Guid="*" Permanent="yes" NeverOverwrite="yes">
      <CreateFolder />
      <RegistryValue Root="HKLM" Key="Software\RoofSpan\Office" Name="DataRoot"
                     Type="string" Value="[DataRoot]" KeyPath="yes" />
    </Component>

    <Component Id="LogsDirAcl" Directory="LogsDir" Guid="*" Permanent="yes" NeverOverwrite="yes">
      <RegistryValue Root="HKLM" Key="Software\RoofSpan\Office" Name="LogsDir"
                     Type="string" Value="[LogsDir]" KeyPath="yes" />
      <CreateFolder>
        <util:PermissionEx User="RoofSpanBackend" Domain="NT SERVICE" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
        <util:PermissionEx User="RoofSpanRelayConnector" Domain="NT SERVICE" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
        <util:PermissionEx User="RoofSpanUpdateService" Domain="NT SERVICE" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
      </CreateFolder>
    </Component>

    <Component Id="IdentityDirAcl" Directory="IdentityDir" Guid="*" Permanent="yes" NeverOverwrite="yes">
      <RegistryValue Root="HKLM" Key="Software\RoofSpan\Office" Name="IdentityDir"
                     Type="string" Value="[IdentityDir]" KeyPath="yes" />
      <CreateFolder>
        <util:PermissionEx User="RoofSpanBackend" Domain="NT SERVICE" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
        <util:PermissionEx User="RoofSpanRelayConnector" Domain="NT SERVICE" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
      </CreateFolder>
    </Component>

    <Component Id="ConfigDirAcl" Directory="ConfigDir" Guid="*" Permanent="yes" NeverOverwrite="yes">
      <RegistryValue Root="HKLM" Key="Software\RoofSpan\Office" Name="ConfigDir"
                     Type="string" Value="[ConfigDir]" KeyPath="yes" />
      <CreateFolder>
        <util:PermissionEx User="RoofSpanBackend" Domain="NT SERVICE" GenericRead="yes" GenericWrite="yes" GenericExecute="yes" />
        <util:PermissionEx User="RoofSpanRelayConnector" Domain="NT SERVICE" GenericRead="yes" GenericExecute="yes" />
        <util:PermissionEx User="RoofSpanUpdateService" Domain="NT SERVICE" GenericRead="yes" GenericExecute="yes" />
      </CreateFolder>
    </Component>

    <Feature Id="Main" Title="RoofSpan Office" Level="1">
      <ComponentGroupRef Id="FrontendFiles" />
      <ComponentGroupRef Id="RuntimeFiles" />
      <ComponentGroupRef Id="ConfigTemplateFiles" />
      <ComponentGroupRef Id="Services" />
      <ComponentGroupRef Id="ServiceInternals" />
      <ComponentRef Id="ShellShortcuts" />
      <ComponentRef Id="DataDirs" />
      <ComponentRef Id="LogsDirAcl" />
      <ComponentRef Id="IdentityDirAcl" />
      <ComponentRef Id="ConfigDirAcl" />
    </Feature>

    <!-- First-run: open the local setup/login UI so the customer runs the existing activation flow. -->
    <CustomAction Id="LaunchFirstRun" Directory="INSTALLFOLDER"
                  ExeCommand="[SystemFolder]cmd.exe /c start &quot;&quot; &quot;http://127.0.0.1:8001/&quot;"
                  Execute="deferred" Impersonate="yes" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="LaunchFirstRun" After="StartServices" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Package>
</Wix>
