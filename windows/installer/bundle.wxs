<?xml version="1.0" encoding="UTF-8"?>
<!--
  RoofSpan Office - WiX 5 (Toolset 5.0.2) Burn bundle. Produces the customer-facing RoofSpanSetup.exe.

  Chain (in order):
    1) WebView2 Evergreen Runtime - FULL Evergreen Standalone x64 installer (offline, no download),
       installed only if absent, machine-level.
    2) PostgreSQL prerequisite (EDB PostgreSQL silent installer) - installed ONLY if a working
       RoofSpan-managed PostgreSQL is not already present. "RoofSpan-managed" means BOTH the
       RoofSpanPostgreSQL service AND the RoofSpan DPAPI credential (pg_super.bin) exist; service
       existence alone is NOT sufficient. Marked Permanent so it is NOT removed on RoofSpan uninstall
       (the customer's database service + data are preserved).
    3) RoofSpanOffice-{VERSION}.msi - the RoofSpan Office application.

  Every package is PerMachine, so a normal double-click triggers the Windows elevation (UAC) prompt;
  customers do NOT need to know to "Run as administrator".

  Contains NO secrets and is NOT customer-specific. Building/signing is HUMAN REQUIRED on Windows.
  Prerequisite binaries are NOT committed; supply their paths through build.ps1. The PostgreSQL helper
  scripts ARE committed and anchored to this bundle's own source directory ($(sys.SOURCEFILEDIR)) so the
  bundle compiles regardless of the caller's working directory (from the repo root OR from installer\).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?include constants.wxi ?>

  <Bundle Name="$(var.ProductName)" Manufacturer="$(var.Manufacturer)"
          Version="$(var.Version)" UpgradeCode="$(var.BundleUpgradeCode)">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense"
                                              SuppressOptionsUI="yes"
                                              LicenseUrl="https://roofspan.io/eula" />
    </BootstrapperApplication>

    <!-- RoofSpan-managed PostgreSQL detection. Service existence alone is insufficient (an unrelated or
         stale service by another name/owner must not satisfy the dependency), so a working managed
         install requires BOTH signals:
           - the RoofSpanPostgreSQL Windows service is registered, AND
           - the RoofSpan DPAPI superuser credential (pg_super.bin) exists (proves RoofSpan owns it).
         The deeper validation (port conflicts, stale/incomplete state, ownership before any repair) is
         performed by Prepare-PostgreSQL.ps1, which runs BEFORE the EDB installer and halts the chain
         with an actionable message when it is not safe to proceed. -->
    <util:RegistrySearch Id="PgServiceSearch" Root="HKLM"
                         Key="SYSTEM\CurrentControlSet\Services\RoofSpanPostgreSQL"
                         Result="exists" Variable="PgServicePresent" />
    <util:FileSearch Id="PgSecretSearch"
                     Path="[CommonAppDataFolder]RoofSpan\identity\pg_super.bin"
                     Result="exists" Variable="PgSecretPresent" />

    <!-- Detect the Evergreen WebView2 Runtime (machine-wide) so we do NOT reinstall it. RoofSpan Office
         requires WebView2. The 'pv' value exists once the runtime is installed. -->
    <util:RegistrySearch Id="WebView2Search" Root="HKLM"
                         Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                         Value="pv" Result="exists" Variable="WebView2Present" />

    <!-- Overridable at build/runtime; no default binary is committed. -->
    <Variable Name="PostgresInstaller" Type="string" Value="$(var.PostgresInstaller)" bal:Overridable="yes" />
    <Variable Name="WebView2StandaloneInstaller" Type="string" Value="$(var.WebView2StandaloneInstaller)" bal:Overridable="yes" />
    <!-- EDB superuser password. NEVER committed and NEVER persisted. WiX 5 requires that a typed
         Variable also declare a Value, so this stays untyped/valueless (empty by default) yet Hidden
         (masked in Burn logs) and Overridable (an admin MAY inject one: RoofSpanSetup.exe PgSuperPassword=...).
         When left empty, the PostgreSQL step below GENERATES a strong random password at runtime. RoofSpan
         first-run then creates its own least-privilege 'roofspan' role + database. -->
    <Variable Name="PgSuperPassword" Hidden="yes" Persisted="no" bal:Overridable="yes" />

    <Chain>
      <!-- 1) WebView2 Evergreen Runtime - FULL Evergreen Standalone x64 installer, EMBEDDED in
              RoofSpanSetup.exe (offline; the customer never downloads the runtime). Skipped when present.
              PerMachine + /silent /install => a machine-wide runtime under elevation. CacheId is explicit
              and version-scoped so it cannot collide with another embedded payload, even when test or
              vendor binaries happen to be byte-identical. -->
      <ExePackage Id="WebView2Runtime"
                  CacheId="RoofSpanWebView2Runtime-$(var.Version)"
                  DisplayName="Microsoft Edge WebView2 Runtime (RoofSpan prerequisite)"
                  SourceFile="$(var.WebView2StandaloneInstaller)"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  InstallCondition="NOT WebView2Present"
                  DetectCondition="WebView2Present"
                  InstallArguments="/silent /install"
                  Compressed="yes" />

      <!-- 2a) PostgreSQL PREP + VALIDATION (RoofSpan-owned helper). ALWAYS runs (no InstallCondition) so it
               can validate/decide in every state, and it HALTS (non-zero, Vital) before the EDB installer
               when it is not safe to proceed. The logic lives in the CHECKED-IN, BUNDLE-EMBEDDED script
               Prepare-PostgreSQL.ps1 (a Burn <Payload> with an explicit Name), NOT inline: WiX Burn formats
               '[...]' tokens in InstallArguments and would strip PowerShell type accelerators ([string],
               [Convert], [Security.Cryptography...], [IO.File], [Text.Encoding]) and corrupt the command
               (the confirmed clean-computer 0x1 failure). The script is invoked by its ABSOLUTE cached path
               via the legitimate Burn engine variable [WixBundleExecutePackageCacheFolder] (NOT a relative
               path). This is a deliberate robustness choice - Burn's per-package working directory is not a
               documented guarantee, so an absolute path removes that dependency. NOTE: an earlier clean run
               failed with 0x80070490 (ERROR_NOT_FOUND) under the previous relative-path launch, but that
               specific cause was never isolated; the absolute path is retained as the safer contract, not
               as a proven fix for that exit code. [PgSuperPassword] stays Hidden (masked in logs) and,
               when empty, the script generates a strong random password itself. -->
      <ExePackage Id="PostgreSQLPasswordPrep"
                  CacheId="RoofSpanPostgreSQLPasswordPrep"
                  DisplayName="RoofSpan PostgreSQL preparation"
                  SourceFile="$(env.SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  InstallArguments="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[WixBundleExecutePackageCacheFolder]\Prepare-PostgreSQL.ps1&quot; -PgSuperPassword &quot;[PgSuperPassword]&quot;"
                  Compressed="yes">
        <Payload Name="Prepare-PostgreSQL.ps1" SourceFile="$(sys.SOURCEFILEDIR)scripts\Prepare-PostgreSQL.ps1" />
      </ExePackage>

      <!-- 2b) PostgreSQL prerequisite = the REAL EDB installer, EMBEDDED in RoofSpanSetup.exe. Reads the
               generated superuser password from the option file; unattended flags + service name preserved.
               PerMachine + unattended => a machine-wide service under elevation. Vital="no" ON PURPOSE: a
               failure here must NOT halt the chain before the cleanup step, so the transient plaintext
               option file is always removed. The subsequent Vital PostgreSQLVerify step re-imposes the
               "PostgreSQL must be healthy before Office" requirement and stops with an actionable error if
               EDB actually failed. Skipped when a working RoofSpan-managed instance already exists. -->
      <ExePackage Id="PostgreSQLPrereq"
                  CacheId="RoofSpanPostgreSQLPrereq-$(var.Version)"
                  DisplayName="PostgreSQL (RoofSpan prerequisite)"
                  SourceFile="$(var.PostgresInstaller)"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="no"
                  InstallCondition="NOT (PgServicePresent AND PgSecretPresent)"
                  DetectCondition="PgServicePresent AND PgSecretPresent"
                  InstallArguments="--optionfile &quot;C:\ProgramData\RoofSpan\identity\pg_install.optionfile&quot; --mode unattended --unattendedmodeui minimal --servicename RoofSpanPostgreSQL"
                  Compressed="yes" />

      <!-- 2c) ALWAYS-run cleanup: remove the transient plaintext option file (the DPAPI-protected
               pg_super.bin remains for first-run). It runs even after an EDB FAILURE (because EDB is
               non-vital), so a failed PostgreSQL install never leaves the plaintext superuser password on
               disk. Bundle-embedded script <Payload>, invoked by absolute cached path. -->
      <ExePackage Id="PostgreSQLPasswordCleanup"
                  CacheId="RoofSpanPostgreSQLPasswordCleanup"
                  DisplayName="RoofSpan PostgreSQL cleanup"
                  SourceFile="$(env.SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="no"
                  InstallArguments="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[WixBundleExecutePackageCacheFolder]\Cleanup-PostgreSQL.ps1&quot;"
                  Compressed="yes">
        <Payload Name="Cleanup-PostgreSQL.ps1" SourceFile="$(sys.SOURCEFILEDIR)scripts\Cleanup-PostgreSQL.ps1" />
      </ExePackage>

      <!-- 2d) HEALTH GATE (Vital): before Office is installed, prove the RoofSpan-managed PostgreSQL is
               actually usable - the RoofSpanPostgreSQL service exists, the DPAPI credential authenticates
               over TCP on 127.0.0.1:5432, and the server version is compatible. This validates BOTH the
               fresh-install path (EDB succeeded) AND the skip path (a pre-existing managed install is
               genuinely healthy, not just present). It halts with an actionable error otherwise, so Office
               is never installed against a missing or broken database. -->
      <ExePackage Id="PostgreSQLVerify"
                  CacheId="RoofSpanPostgreSQLVerify"
                  DisplayName="RoofSpan PostgreSQL health check"
                  SourceFile="$(env.SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  InstallArguments="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[WixBundleExecutePackageCacheFolder]\Verify-PostgreSQL.ps1&quot;"
                  Compressed="yes">
        <Payload Name="Verify-PostgreSQL.ps1" SourceFile="$(sys.SOURCEFILEDIR)scripts\Verify-PostgreSQL.ps1" />
      </ExePackage>

      <!-- 3) RoofSpan Office MSI (built by RoofSpan.wxs), EMBEDDED. perMachine (see RoofSpan.wxs Scope). -->
      <MsiPackage Id="RoofSpanOfficeMsi"
                  CacheId="RoofSpanOfficeMsi-$(var.Version)"
                  SourceFile="$(var.MsiPath)" Vital="yes" Compressed="yes" />
    </Chain>
  </Bundle>
</Wix>
