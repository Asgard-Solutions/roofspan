<?xml version="1.0" encoding="UTF-8"?>
<!--
  RoofSpan Office - WiX 5 (Toolset 5.0.2) Burn bundle. Produces the customer-facing RoofSpanSetup.exe.

  Chain (in order):
    1) WebView2 Evergreen Runtime — installed only if absent.
    2) PostgreSQL prerequisite (EDB PostgreSQL silent installer) — installed ONLY if a compatible
       PostgreSQL is not already present (detected via registry). Marked Permanent so it is NOT removed
       on RoofSpan uninstall (the customer's database service + data are preserved).
    3) RoofSpanOffice-{VERSION}.msi — the RoofSpan Office application.

  Contains NO secrets and is NOT customer-specific. Building/signing is HUMAN REQUIRED on Windows.
  Prerequisite binaries are NOT committed; supply their paths through build.ps1.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?include constants.wxi ?>

  <Bundle Name="$(var.ProductName)" Manufacturer="$(var.Manufacturer)"
          Version="$(var.Version)" UpgradeCode="$(var.BundleUpgradeCode)">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense"
                                              SuppressOptionsUI="yes"
                                              LicenseUrl="https://roofspan.io/eula" />
    </BootstrapperApplication>

    <!-- Detect an existing (RoofSpan-managed or compatible) PostgreSQL install so we do NOT reinstall. -->
    <util:RegistrySearch Id="PgPresentSearch" Root="HKLM"
                         Key="SOFTWARE\PostgreSQL\Installations"
                         Result="exists" Variable="PgPresent" />

    <!-- Detect the Evergreen WebView2 Runtime (machine-wide) so we do NOT reinstall it. RoofSpan Office
         requires WebView2. The 'pv' value exists once the runtime is installed. -->
    <util:RegistrySearch Id="WebView2Search" Root="HKLM"
                         Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                         Value="pv" Result="exists" Variable="WebView2Present" />

    <!-- Overridable at build/runtime; no default binary is committed. -->
    <Variable Name="PostgresInstaller" Type="string" Value="$(var.PostgresInstaller)" bal:Overridable="yes" />
    <Variable Name="WebView2Bootstrapper" Type="string" Value="$(var.WebView2Bootstrapper)" bal:Overridable="yes" />
    <!-- EDB superuser password. NEVER committed and NEVER persisted. WiX 5 requires that a typed
         Variable also declare a Value, so this stays untyped/valueless (empty by default) yet Hidden
         (masked in Burn logs) and Overridable (an admin MAY inject one: RoofSpanSetup.exe PgSuperPassword=...).
         When left empty, the PostgreSQL step below GENERATES a strong random password at runtime. RoofSpan
         first-run then creates its own least-privilege 'roofspan' role + database. -->
    <Variable Name="PgSuperPassword" Hidden="yes" Persisted="no" bal:Overridable="yes" />

    <Chain>
      <!-- 1) WebView2 Evergreen Runtime (silent), EMBEDDED in RoofSpanSetup.exe. Skipped when present.
              CacheId is explicit and version-scoped so it cannot collide with another embedded payload,
              even when test or vendor bootstrapper binaries happen to be byte-identical. -->
      <ExePackage Id="WebView2Runtime"
                  CacheId="RoofSpanWebView2Runtime-$(var.Version)"
                  DisplayName="Microsoft Edge WebView2 Runtime (RoofSpan prerequisite)"
                  SourceFile="$(var.WebView2Bootstrapper)"
                  Permanent="yes"
                  Vital="yes"
                  InstallCondition="NOT WebView2Present"
                  DetectCondition="WebView2Present"
                  InstallArguments="/silent /install"
                  Compressed="yes" />

      <!-- 2a) PostgreSQL password PREP (RoofSpan-owned helper, runs BEFORE the EDB installer). The prep
               logic lives in the CHECKED-IN, BUNDLE-EMBEDDED script Prepare-PostgreSQL.ps1 (a Burn
               <Payload>), NOT inline: WiX Burn formats '[...]' tokens in InstallArguments and would strip
               PowerShell type accelerators ([string], [Convert], [Security.Cryptography...], [IO.File],
               [Text.Encoding]) and corrupt the command (the confirmed clean-computer 0x1 failure). Only
               the legitimate [PgSuperPassword] Burn variable remains a bracket token here; it is Hidden
               (masked in logs) and, when empty, the script generates a strong random password itself.
               Uses the OS PowerShell as a small helper payload - it does NOT replace the PostgreSQL package.
               Burn extracts the ExePackage payloads together and runs powershell.exe with that package
               working directory, so the script is referenced by its payload name. -->
      <ExePackage Id="PostgreSQLPasswordPrep"
                  CacheId="RoofSpanPostgreSQLPasswordPrep"
                  DisplayName="RoofSpan PostgreSQL preparation"
                  SourceFile="$(env.SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe"
                  Permanent="yes"
                  Vital="yes"
                  InstallCondition="NOT PgPresent"
                  InstallArguments="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File Prepare-PostgreSQL.ps1 -PgSuperPassword &quot;[PgSuperPassword]&quot;"
                  Compressed="yes">
        <Payload SourceFile="scripts\Prepare-PostgreSQL.ps1" />
      </ExePackage>

      <!-- 2b) PostgreSQL prerequisite = the REAL EDB installer, EMBEDDED in RoofSpanSetup.exe. Reads the
               generated superuser password from the option file; unattended flags + service name preserved.
               Explicit version-scoped CacheId prevents collisions with any other embedded executable. -->
      <ExePackage Id="PostgreSQLPrereq"
                  CacheId="RoofSpanPostgreSQLPrereq-$(var.Version)"
                  DisplayName="PostgreSQL (RoofSpan prerequisite)"
                  SourceFile="$(var.PostgresInstaller)"
                  Permanent="yes"
                  Vital="yes"
                  InstallCondition="NOT PgPresent"
                  DetectCondition="PgPresent"
                  InstallArguments="--optionfile &quot;C:\ProgramData\RoofSpan\identity\pg_install.optionfile&quot; --mode unattended --unattendedmodeui minimal --servicename RoofSpanPostgreSQL"
                  Compressed="yes" />

      <!-- 2c) Remove the transient option file (the DPAPI-protected pg_super.bin remains for first-run).
               Also a BUNDLE-EMBEDDED script <Payload> (Cleanup-PostgreSQL.ps1) rather than inline, for the
               same Burn-formatting safety and to keep both PostgreSQL helpers uniform and regression-tested. -->
      <ExePackage Id="PostgreSQLPasswordCleanup"
                  CacheId="RoofSpanPostgreSQLPasswordCleanup"
                  DisplayName="RoofSpan PostgreSQL cleanup"
                  SourceFile="$(env.SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe"
                  Permanent="yes"
                  Vital="no"
                  InstallCondition="NOT PgPresent"
                  InstallArguments="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File Cleanup-PostgreSQL.ps1"
                  Compressed="yes">
        <Payload SourceFile="scripts\Cleanup-PostgreSQL.ps1" />
      </ExePackage>

      <!-- 3) RoofSpan Office MSI (built by RoofSpan.wxs), EMBEDDED. -->
      <MsiPackage Id="RoofSpanOfficeMsi"
                  CacheId="RoofSpanOfficeMsi-$(var.Version)"
                  SourceFile="$(var.MsiPath)" Vital="yes" Compressed="yes" />
    </Chain>
  </Bundle>
</Wix>
