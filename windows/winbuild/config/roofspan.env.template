# RoofSpan Office local configuration TEMPLATE - NO SECRETS.
# Copied to C:\ProgramData\RoofSpan\config\ on first run; the local backend fills in generated
# database/auth/encryption credentials locally. Real secret values are never committed or shipped.

# Local business database (RoofSpan-owned least-privilege role; password generated at first run).
DATABASE_URL=postgresql+asyncpg://roofspan:__GENERATED_AT_FIRST_RUN__@127.0.0.1:5432/roofspan

# Per-installation authentication + encrypted-settings secrets. Generated once and preserved across
# service restarts, upgrades, and reinstalls so login tokens and locally encrypted settings remain valid.
JWT_SECRET=__GENERATED_JWT_SECRET__
SECRETS_ENCRYPTION_KEY=__GENERATED_SECRETS_ENCRYPTION_KEY__

# Installation identity keys (PRESERVED across upgrades/reinstalls).
INSTALLATION_KEYS_DIR=C:\ProgramData\RoofSpan\identity

# Field-photo storage. This is machine data, not application payload, and must survive Office upgrades.
# The MSI grants the RoofSpanBackend virtual service account read/write access to this directory.
PHOTO_STORAGE_DIR=C:\ProgramData\RoofSpan\images

# Packaged Office UI (served by the local backend at http://127.0.0.1:8001/).
ROOFSPAN_STATIC_DIR=C:\Program Files\RoofSpan Office\frontend

# Authoritative software version. The frozen service runtime also embeds windows\VERSION so preserved
# upgrade configs cannot leave the running service on an obsolete version value.
ROOFSPAN_VERSION=0.4.5

# Hosted Control Plane + Secure Relay. Office creates pairing codes on the same Control Plane used by
# Mobile, and the connector authenticates an outbound-only tunnel with that hosted installation id.
CONTROL_PLANE_BASE_URL=https://cp.roofspan.io
RELAY_WSS_URL=wss://relay.roofspan.io
ROOFSPAN_RELAY_WS_URL=wss://relay.roofspan.io/api/relay/installation
ROOFSPAN_LOCAL_API_URL=http://127.0.0.1:8001
ROOFSPAN_WINDOWS_UPDATE_MANIFEST_URL=https://downloads.roofspan.io/update/windows/latest.json

# Update-verification PUBLIC key (public only - the private key never ships).
ROOFSPAN_UPDATE_PUBLIC_KEY=C:\Program Files\RoofSpan Office\config-templates\update_public_key.pem

# Full-database backup location (PostgreSQL custom-format dumps). Writable by the RoofSpan service account.
ROOFSPAN_BACKUP_DIR=C:\ProgramData\RoofSpan\backups

# PostgreSQL client tools (pg_dump/pg_restore/psql). RoofSpan ships EDB PostgreSQL 16, which installs its
# executables here. Backup/restore invoke these by full path and never rely on the Windows PATH.
ROOFSPAN_PG_VERSION=16
ROOFSPAN_PG_BIN=C:\Program Files\PostgreSQL\16\bin

# Off-site (secondary) backup: an OPTIONAL copy of each completed local backup to a customer-selected,
# Windows-accessible directory (another/USB/external drive, NAS, UNC share, or a locally-synced
# OneDrive/Dropbox/Google Drive folder). Plain file copy - no cloud API, no AWS/S3, no credentials.
# The location is normally chosen in the Backups page and stored in machine config; this env var is an
# optional default. For network shares prefer a UNC path (\\Server\Share\RoofSpan) over a mapped drive.
ROOFSPAN_OFFSITE_BACKUP_DIR=
