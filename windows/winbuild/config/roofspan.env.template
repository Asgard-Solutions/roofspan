# RoofSpan Office local configuration TEMPLATE — NO SECRETS. This file ships under Program Files
# (config-templates). On a FRESH install, RoofSpanBootstrap.exe generates a unique local DB password,
# provisions the local `roofspan` role + database, and renders this into the DEPLOYED config at
# C:\ProgramData\RoofSpan\config\roofspan.env (with the real DATABASE_URL) BEFORE RoofSpanBackend starts.
# Upgrades PRESERVE the existing deployed config. The Backend must never run with the literal placeholder.
# Copied to C:\ProgramData\RoofSpan\config\ on first run; the local backend fills in generated
# database credentials at first run (never committed, never shipped in the installer).

# Local business database (RoofSpan-owned least-privilege role; password generated at first run).
# Dedicated RoofSpan-managed PostgreSQL port 5442 (NOT 5432) so it never collides with an unrelated
# PostgreSQL install; must match the EDB --serverport handed off by the Burn bundle (PgPort).
DATABASE_URL=postgresql+asyncpg://roofspan:__GENERATED_AT_FIRST_RUN__@127.0.0.1:5442/roofspan

# Installation identity keys (PRESERVED across upgrades/reinstalls).
INSTALLATION_KEYS_DIR=C:\ProgramData\RoofSpan\identity

# Packaged Office UI (served by the local backend at http://127.0.0.1:8001/).
ROOFSPAN_STATIC_DIR=C:\Program Files\RoofSpan Office\frontend

# Authoritative software version (written from windows\VERSION at install time).
ROOFSPAN_VERSION=0.1.0

# --- Production runtime modes (dev/test override these locally) ---
# Real Control Plane licensing client (NOT the dev in-process signer; NO 1000-seat auto-issue).
LICENSING_MODE=http
# Stripe is the authoritative RoofSpan seat/subscription billing engine in production.
BILLING_MODE=stripe

# Per-installation secrets JWT_SECRET + SECRETS_ENCRYPTION_KEY are GENERATED on first start and stored in
# C:\ProgramData\RoofSpan\config\secrets.env (unique per installation; preserved across upgrade; never
# shipped in this template and never committed). Do NOT add them here.

# Secure Relay endpoint (outbound only) + Control Plane. Production clients receive EXPLICIT values;
# the Relay URL is NOT derived from the Control Plane URL. The Relay Connector service (relay_entry.py)
# loads THIS file from C:\ProgramData\RoofSpan\config on startup (service env vars take precedence).
CONTROL_PLANE_BASE_URL=https://cp.roofspan.io
RELAY_WSS_URL=wss://relay.roofspan.io
ROOFSPAN_RELAY_WS_URL=wss://relay.roofspan.io/api/relay/tunnel
ROOFSPAN_LOCAL_API_URL=http://127.0.0.1:8001
# Connector rotating log -> C:\ProgramData\RoofSpan\logs\relay-connector.log (override dir if needed).
ROOFSPAN_LOG_DIR=C:\ProgramData\RoofSpan\logs
ROOFSPAN_WINDOWS_UPDATE_MANIFEST_URL=https://downloads.roofspan.io/update/windows/latest.json

# Update-verification PUBLIC key (public only — the private key never ships).
ROOFSPAN_UPDATE_PUBLIC_KEY=C:\Program Files\RoofSpan Office\config-templates\update_public_key.pem
